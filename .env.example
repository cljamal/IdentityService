APP_NAME=IdentityService
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Session/cache/queue all run on Redis, not the database — see below.
# There's nothing to configure here beyond the Redis connection itself.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# JWT (php-open-source-saver/jwt-auth) — the "id-api" guard's tokens.
# Pick ONE of the two setups below.
# ------------------------------------------------------------------

# Option A — HS256 (symmetric, simplest): generate with `php artisan jwt:secret`.
# JWT_SECRET=

# Option B — RS256 (asymmetric): set JWT_ALGO=RS256 and point these at a
# key pair (see `php artisan jwt:generate-certs` or provide your own).
# JWT_ALGO=RS256
# JWT_PUBLIC_KEY=
# JWT_PRIVATE_KEY=
# JWT_PASSPHRASE=

JWT_TTL=60
# jwt-auth's own refresh window — unused by us directly, since /auth/refresh
# no longer calls the package's refresh() (see AUTH_REFRESH_TOKEN_TTL below).
# Left at its default so the package's own config stays valid.
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# ------------------------------------------------------------------
# Refresh tokens (config/identity.php) — the opaque token /auth/refresh
# actually accepts. Rotated on every use; minutes.
# ------------------------------------------------------------------

AUTH_REFRESH_TOKEN_TTL=20160
AUTH_REFRESH_REUSE_GRACE_SECONDS=30

# ------------------------------------------------------------------
# Identity providers (config/identity.php) — toggle each one off without
# removing its code/routes. All default to enabled.
# ------------------------------------------------------------------

AUTH_PROVIDER_PHONE_OTP_ENABLED=true
AUTH_PROVIDER_EMAIL_PASSWORD_ENABLED=true
AUTH_PROVIDER_USERNAME_PASSWORD_ENABLED=true

# "username" has no delivery channel of its own, so password reset for it
# only works if you point this at a table that maps a user to some other
# contact (email/phone) to send the reset code to. Leave AUTH_USERNAME_PASSWORD_RESCUE_TABLE
# empty to keep it unsupported (password/forgot then responds 400 and
# never touches the database) — this is the default, working state.
AUTH_USERNAME_PASSWORD_RESCUE_TABLE=
AUTH_USERNAME_PASSWORD_RESCUE_USER_ID_COLUMN=user_id
AUTH_USERNAME_PASSWORD_RESCUE_KEY_COLUMN=meta_key
AUTH_USERNAME_PASSWORD_RESCUE_VALUE_COLUMN=meta_value
AUTH_USERNAME_PASSWORD_RESCUE_META_KEY=email

# Country calling codes allowed to register/login via phone-otp.
PHONE_COUNTRY_UZ_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
