meta {
  name: Confirm Account Deletion
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/email-password/account/delete/confirm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{emailToken}}
}

body:json {
  {
    "code": "{{otpCode}}"
  }
}

docs {
  Удаляет аккаунт и все его identities через soft delete, освобождает идентификаторы,
  отзывает все сессии и инвалидирует текущий токен. Подтверждение — кодом из
  Request Account Deletion. Сохранённые токены аккаунта больше не действуют.
}
