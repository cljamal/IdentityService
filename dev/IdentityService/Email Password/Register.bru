meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/email-password/register
  body: json
  auth: none
}

body:json {
  {
    "email": "user@example.com",
    "password": "password123",
    "password_confirmation": "password123"
  }
}

docs {
  Email всегда требует подтверждения кодом (см. Verify Registration) — токен сразу не выдаётся.
}
