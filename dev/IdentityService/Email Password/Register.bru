meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/email-password/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{initialPassword}}",
    "password_confirmation": "{{initialPassword}}"
  }
}

docs {
  Email всегда требует подтверждения кодом (см. Verify Registration) — токен сразу не выдаётся.
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("emailPassword", bru.getEnvVar("initialPassword"));
  }
}
