meta {
  name: Change Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/email-password/password/change
  body: json
  auth: bearer
}

auth:bearer {
  token: {{emailToken}}
}

body:json {
  {
    "current_password": "password123",
    "password": "newpassword123",
    "password_confirmation": "newpassword123"
  }
}
