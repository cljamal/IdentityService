meta {
  name: Verify Registration
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/email-password/register/verify
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "code": "{{otpCode}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data && res.body.data.access_token) {
    bru.setVar("emailToken", res.body.data.access_token);
    bru.setVar("token", res.body.data.access_token);
    bru.setVar("refreshToken", res.body.data.refresh_token);
  }
}

docs {
  Подтверждает код, отправленный при регистрации, и сразу выдаёт JWT.
}
