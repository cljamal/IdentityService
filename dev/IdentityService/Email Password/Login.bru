meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/email-password/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{emailPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data && res.body.data.access_token) {
    bru.setVar("emailToken", res.body.data.access_token);
    bru.setVar("token", res.body.data.access_token);
    bru.setVar("refreshToken", res.body.data.refresh_token);
  }
}

example {
  name: 200
  description: Демонстрационный ответ; значения токенов и дат приведены для примера.

  request: {
    url: {{baseUrl}}/auth/email-password/login
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "email": "{{email}}",
        "password": "{{emailPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "access_token": "<access-token>",
            "refresh_token": "<refresh-token>",
            "token_type": "bearer",
            "expires_in": 3600,
            "refresh_expires_in": 1209600
          }
        }
      '''
    }
  }
}

example {
  name: 401 CLIENT_AUTHENTICATION_FAILED
  description: Отсутствующие/неверные credentials или отключённый клиент.

  request: {
    url: {{baseUrl}}/auth/email-password/login
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: <invalid-client-secret>
      Content-Type: application/json
    }
    body:json: {
      {
        "email": "{{email}}",
        "password": "{{emailPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "code": "CLIENT_AUTHENTICATION_FAILED"
        }
      '''
    }
  }
}

example {
  name: 404 AUTH_PROVIDER_DISABLED
  description: Провайдер отключён в конфигурации.

  request: {
    url: {{baseUrl}}/auth/email-password/login
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "email": "{{email}}",
        "password": "{{emailPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 404
      text: Not Found
    }
    body: {
      type: json
      content: '''
        {
          "code": "AUTH_PROVIDER_DISABLED"
        }
      '''
    }
  }
}

example {
  name: 429 HTTP_RATE_LIMIT
  description: Ограничение частоты HTTP-запросов; отличается от OTP cooldown. APP_DEBUG=false.

  request: {
    url: {{baseUrl}}/auth/email-password/login
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "email": "{{email}}",
        "password": "{{emailPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
      retry-after: 60
    }
    status: {
      code: 429
      text: Too Many Requests
    }
    body: {
      type: json
      content: '''
        {
          "message": "Too Many Attempts."
        }
      '''
    }
  }
}

