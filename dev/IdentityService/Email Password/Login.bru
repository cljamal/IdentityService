meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/email-password/login
  body: json
  auth: none
}

body:json {
  {
    "email": "user@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data && res.body.data.access_token) {
    bru.setEnvVar("emailToken", res.body.data.access_token);
    bru.setEnvVar("token", res.body.data.access_token);
  }
}
