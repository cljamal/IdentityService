meta {
  name: Forgot Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/email-password/password/forgot
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

docs {
  Всегда отвечает одинаково, есть аккаунт или нет — чтобы email нельзя было
  проверить на существование через этот эндпоинт.
}
