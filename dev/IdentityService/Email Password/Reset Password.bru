meta {
  name: Reset Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/email-password/password/reset
  body: json
  auth: none
}

body:json {
  {
    "email": "user@example.com",
    "code": "1111",
    "password": "newpassword123",
    "password_confirmation": "newpassword123"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data && res.body.data.access_token) {
    bru.setEnvVar("emailToken", res.body.data.access_token);
    bru.setEnvVar("token", res.body.data.access_token);
    bru.setEnvVar("refreshToken", res.body.data.refresh_token);
  }
}
