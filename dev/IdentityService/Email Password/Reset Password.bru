meta {
  name: Reset Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/email-password/password/reset
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "code": "{{otpCode}}",
    "password": "{{resetPassword}}",
    "password_confirmation": "{{resetPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data && res.body.data.access_token) {
    bru.setVar("emailPassword", bru.getEnvVar("resetPassword"));
    bru.setVar("emailToken", res.body.data.access_token);
    bru.setVar("token", res.body.data.access_token);
    bru.setVar("refreshToken", res.body.data.refresh_token);
  }
}

docs {
  Меняет пароль, подтверждает identity и отзывает все прежние сессии.
  Сохраняет новую пару токенов и актуальный emailPassword для следующих запросов.
}
