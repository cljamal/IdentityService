meta {
  name: Me
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Показывает декодированный JWT и читаемые даты. Маршрут зарегистрирован всегда;
  контроллер возвращает 404 при APP_ENV=production. Нужны credentials клиента и JWT.
}
