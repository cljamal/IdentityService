meta {
  name: Me
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Дев-эндпоинт: раскодированный JWT текущего запроса (claims + читаемые
  issued_at/expires_at/age_seconds/expires_in_seconds) плюс краткая info
  о пользователе. Регистрируется везде, кроме APP_ENV=production
  (см. routes/api.php) — там вернёт 404.
}
