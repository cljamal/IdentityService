meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/username-password/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{initialPassword}}",
    "password_confirmation": "{{initialPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("usernamePassword", bru.getEnvVar("initialPassword"));
  }
  if (res.status === 200 && res.body && res.body.data && res.body.data.access_token) {
    bru.setVar("usernameToken", res.body.data.access_token);
    bru.setVar("token", res.body.data.access_token);
    bru.setVar("refreshToken", res.body.data.refresh_token);
  }
}

docs {
  Без найденного rescue-контакта identity подтверждается сразу и возвращаются токены.
  При наличии контакта требуется Verify Registration. Таблица — дополнительный
  источник; сначала resolver проверяет подтверждённые identities пользователя.
}

example {
  name: 200 Токены
  description: Rescue-контакт отсутствует; регистрация завершена.

  request: {
    url: {{baseUrl}}/auth/username-password/register
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}",
        "password": "{{initialPassword}}",
        "password_confirmation": "{{initialPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "access_token": "<access-token>",
            "refresh_token": "<refresh-token>",
            "token_type": "bearer",
            "expires_in": 3600,
            "refresh_expires_in": 1209600
          }
        }
      '''
    }
  }
}

example {
  name: 200 Требуется подтверждение
  description: Демонстрационный ответ; значения токенов и дат приведены для примера.

  request: {
    url: {{baseUrl}}/auth/username-password/register
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}",
        "password": "{{initialPassword}}",
        "password_confirmation": "{{initialPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "message": "Мы отправили код подтверждения. Подтвердите его, чтобы завершить регистрацию."
          }
        }
      '''
    }
  }
}

example {
  name: 401 CLIENT_AUTHENTICATION_FAILED
  description: Отсутствующие/неверные credentials или отключённый клиент.

  request: {
    url: {{baseUrl}}/auth/username-password/register
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: <invalid-client-secret>
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}",
        "password": "{{initialPassword}}",
        "password_confirmation": "{{initialPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "code": "CLIENT_AUTHENTICATION_FAILED"
        }
      '''
    }
  }
}

