}

example {
  name: 429 HTTP_RATE_LIMIT
  description: Ограничение частоты HTTP-запросов; отличается от OTP cooldown. APP_DEBUG=false.

  request: {
    url: {{baseUrl}}/auth/username-password/register
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}",
        "password": "{{initialPassword}}",
        "password_confirmation": "{{initialPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
      retry-after: 60
    }
    status: {
      code: 429
      text: Too Many Requests
    }
    body: {
      type: json
      content: '''
        {
          "message": "Too Many Attempts."
        }
      '''
    }
  }
}

example {
  name: 429 OTP_THROTTLED
  description: Повторная выдача OTP до завершения cooldown; retry_after зависит от оставшегося времени.

  request: {
    url: {{baseUrl}}/auth/username-password/register
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}",
        "password": "{{initialPassword}}",
        "password_confirmation": "{{initialPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 429
      text: Too Many Requests
    }
    body: {
      type: json
      content: '''
        {
          "code": "OTP_THROTTLED",
          "retry_after": 60
        }
      '''
    }
  }
}

example {
  name: 422 IDENTIFIER_ALREADY_TAKEN
  description: Конкурирующий запрос занял идентификатор после проверки уникальности.

  request: {
    url: {{baseUrl}}/auth/username-password/register
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}",
        "password": "{{initialPassword}}",
        "password_confirmation": "{{initialPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 422
      text: Unprocessable Entity
    }
    body: {
      type: json
      content: '''
        {
          "code": "IDENTIFIER_ALREADY_TAKEN"
        }
      '''
    }
  }
}

example {
  name: 422 VALIDATION_ERROR
  description: Обязательное поле отсутствует; пример для APP_LOCALE=en.

  request: {
    url: {{baseUrl}}/auth/username-password/register
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "password": "{{initialPassword}}",
        "password_confirmation": "{{initialPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 422
      text: Unprocessable Entity
    }
    body: {
      type: json
      content: '''
        {
          "message": "The username field is required.",
          "errors": {
            "username": [
              "The username field is required."
            ]
          }
        }
      '''
    }
  }
}

example {
  name: 422 SMS_TEMPLATE_INVALID
  description: Демонстрационный ответ; значения токенов и дат приведены для примера.

  request: {
    url: {{baseUrl}}/auth/username-password/register
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}",
        "password": "{{initialPassword}}",
        "password_confirmation": "{{initialPassword}}",
        "sms": {
          "template": "Ваш код"
        }
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 422
      text: Unprocessable Entity
    }
    body: {
      type: json
      content: '''
        {
          "message": "Шаблон должен содержать {{code}} и только подстановки вида {{name}}.",
          "errors": {
            "sms.template": [
              "Шаблон должен содержать {{code}} и только подстановки вида {{name}}."
            ]
          }
        }
      '''
    }
  }
}

example {
  name: 422 IDENTIFIER_VALIDATION
  description: Идентификатор занят при обычной проверке уникальности; APP_LOCALE=en.

  request: {
    url: {{baseUrl}}/auth/username-password/register
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}",
        "password": "{{initialPassword}}",
        "password_confirmation": "{{initialPassword}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 422
      text: Unprocessable Entity
