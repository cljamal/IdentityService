meta {
  name: Verify Registration
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/username-password/register/verify
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "code": "{{otpCode}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data && res.body.data.access_token) {
    bru.setVar("usernameToken", res.body.data.access_token);
    bru.setVar("token", res.body.data.access_token);
    bru.setVar("refreshToken", res.body.data.refresh_token);
  }
}

docs {
  Выполняйте только если Register вернул сообщение о подтверждении, а не токены.
  Это означает, что resolver нашёл rescue-контакт. Без него шаг пропускается.
}
