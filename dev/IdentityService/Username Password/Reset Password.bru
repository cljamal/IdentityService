meta {
  name: Reset Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/username-password/password/reset
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "code": "{{otpCode}}",
    "password": "{{resetPassword}}",
    "password_confirmation": "{{resetPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data && res.body.data.access_token) {
    bru.setVar("usernamePassword", bru.getEnvVar("resetPassword"));
    bru.setVar("usernameToken", res.body.data.access_token);
    bru.setVar("token", res.body.data.access_token);
    bru.setVar("refreshToken", res.body.data.refresh_token);
  }
}

docs {
  Подтверждает код восстановления, меняет пароль, подтверждает identity,
  отзывает все старые сессии и выдаёт новую пару. Отсутствие rescue-таблицы
  само по себе не означает 400: контакт может находиться в linked identity.
}
