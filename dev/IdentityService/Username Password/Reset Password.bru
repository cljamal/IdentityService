meta {
  name: Reset Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/username-password/password/reset
  body: json
  auth: none
}

body:json {
  {
    "username": "john_doe",
    "code": "1111",
    "password": "newpassword123",
    "password_confirmation": "newpassword123"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data && res.body.data.access_token) {
    bru.setEnvVar("usernameToken", res.body.data.access_token);
    bru.setEnvVar("token", res.body.data.access_token);
  }
}

docs {
  Как и Forgot Password, требует настроенной rescue-таблицы, иначе 400.
}
