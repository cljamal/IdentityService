meta {
  name: Forgot Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/username-password/password/forgot
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}"
  }
}

docs {
  Ищет подтверждённый email, затем телефон того же пользователя, затем настроенную
  rescue-таблицу. Без контакта код/cooldown сохраняются, но доставка не выполняется.
  Успешный ответ не подтверждает существование аккаунта или доставку кода.
}
