meta {
  name: Forgot Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/username-password/password/forgot
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}"
  }
}

docs {
  Ищет подтверждённый email, затем телефон того же пользователя, затем настроенную
  rescue-таблицу. Без контакта код/cooldown сохраняются, но доставка не выполняется.
  Успешный ответ не подтверждает существование аккаунта или доставку кода.
}

example {
  name: 200
  description: Демонстрационный ответ; значения токенов и дат приведены для примера.

  request: {
    url: {{baseUrl}}/auth/username-password/password/forgot
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "message": "Если такой аккаунт существует, код отправлен."
          }
        }
      '''
    }
  }
}

example {
  name: 401 CLIENT_AUTHENTICATION_FAILED
  description: Отсутствующие/неверные credentials или отключённый клиент.

  request: {
    url: {{baseUrl}}/auth/username-password/password/forgot
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: <invalid-client-secret>
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "code": "CLIENT_AUTHENTICATION_FAILED"
        }
      '''
    }
  }
}

example {
  name: 404 AUTH_PROVIDER_DISABLED
  description: Провайдер отключён в конфигурации.

  request: {
    url: {{baseUrl}}/auth/username-password/password/forgot
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 404
      text: Not Found
    }
    body: {
      type: json
      content: '''
        {
          "code": "AUTH_PROVIDER_DISABLED"
        }
      '''
    }
  }
}

example {
  name: 400 UNSUPPORTED_AUTH_OPERATION
  description: Указанный в примере провайдер не поддерживает эту операцию.

  request: {
    url: {{baseUrl}}/auth/phone-otp/password/forgot
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 400
      text: Bad Request
    }
    body: {
      type: json
      content: '''
        {
          "code": "UNSUPPORTED_AUTH_OPERATION"
        }
      '''
    }
  }
}

example {
  name: 429 HTTP_RATE_LIMIT
  description: Ограничение частоты HTTP-запросов; отличается от OTP cooldown. APP_DEBUG=false.

  request: {
    url: {{baseUrl}}/auth/username-password/password/forgot
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
      retry-after: 60
    }
    status: {
      code: 429
      text: Too Many Requests
    }
    body: {
      type: json
      content: '''
        {
          "message": "Too Many Attempts."
        }
      '''
    }
  }
}

example {
  name: 429 OTP_THROTTLED
  description: Повторная выдача OTP до завершения cooldown; retry_after зависит от оставшегося времени.

  request: {
    url: {{baseUrl}}/auth/username-password/password/forgot
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 429
      text: Too Many Requests
    }
    body: {
      type: json
      content: '''
        {
          "code": "OTP_THROTTLED",
          "retry_after": 60
        }
      '''
    }
  }
}

example {
  name: 422 VALIDATION_ERROR
  description: Обязательное поле отсутствует; пример для APP_LOCALE=en.

  request: {
    url: {{baseUrl}}/auth/username-password/password/forgot
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {}
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 422
      text: Unprocessable Entity
    }
    body: {
      type: json
      content: '''
        {
          "message": "The username field is required.",
          "errors": {
            "username": [
              "The username field is required."
            ]
          }
        }
      '''
    }
  }
}

example {
  name: 422 SMS_TEMPLATE_INVALID
  description: Демонстрационный ответ; значения токенов и дат приведены для примера.

  request: {
    url: {{baseUrl}}/auth/username-password/password/forgot
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "username": "{{username}}",
        "sms": {
          "template": "Ваш код"
        }
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 422
      text: Unprocessable Entity
    }
    body: {
      type: json
      content: '''
        {
          "message": "Шаблон должен содержать {{code}} и только подстановки вида {{name}}.",
          "errors": {
            "sms.template": [
              "Шаблон должен содержать {{code}} и только подстановки вида {{name}}."
            ]
          }
        }
      '''
    }
  }
}
