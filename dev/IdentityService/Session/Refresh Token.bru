meta {
  name: Refresh Token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data && res.body.data.access_token) {
    bru.setEnvVar("token", res.body.data.access_token);
    bru.setEnvVar("refreshToken", res.body.data.refresh_token);
  }
}

docs {
  Меняет refresh_token на новую пару access/refresh (общие переменные token/refreshToken,
  не привязаны к провайдеру). Без Authorization — сам refresh_token и есть credential.
  Старый refresh_token после этого больше не действует; повторное его предъявление
  отзовёт всю сессию (см. REFRESH_TOKEN_REUSED).
}
