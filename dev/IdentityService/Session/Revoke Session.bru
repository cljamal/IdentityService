meta {
  name: Revoke Session
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/auth/sessions/{{sessionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Задайте sessionId из ответа List Sessions; ID не выбирается автоматически.
  Чужая, несуществующая или отозванная сессия возвращает 404 SESSION_NOT_FOUND.
  После отзыва текущей сессии её access/refresh tokens больше не действуют.
}

script:pre-request {
  if (!bru.getEnvVar("sessionId")) {
    throw new Error("Укажите sessionId из List Sessions.");
  }
}

example {
  name: 200
  description: Демонстрационный ответ; значения токенов и дат приведены для примера.

  request: {
    url: {{baseUrl}}/auth/sessions/{{sessionId}}
    method: DELETE
    mode: none
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "message": "Сессия отозвана."
          }
        }
      '''
    }
  }
}

example {
  name: 401 CLIENT_AUTHENTICATION_FAILED
  description: Отсутствующие/неверные credentials или отключённый клиент.

  request: {
    url: {{baseUrl}}/auth/sessions/{{sessionId}}
    method: DELETE
    mode: none
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: <invalid-client-secret>
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "code": "CLIENT_AUTHENTICATION_FAILED"
        }
      '''
    }
  }
}

example {
  name: 401 UNAUTHENTICATED
  description: Отсутствующий, истёкший, отозванный или недействительный JWT.

  request: {
    url: {{baseUrl}}/auth/sessions/{{sessionId}}
    method: DELETE
    mode: none
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Authorization: Bearer <invalid-access-token>
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "message": "Unauthenticated."
        }
      '''
    }
  }
}

example {
  name: 404 SESSION_NOT_FOUND
  description: Сессия отсутствует, уже отозвана или принадлежит другому пользователю.

  request: {
    url: {{baseUrl}}/auth/sessions/{{sessionId}}
    method: DELETE
    mode: none
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 404
      text: Not Found
    }
    body: {
      type: json
      content: '''
        {
          "code": "SESSION_NOT_FOUND"
        }
      '''
    }
  }
}
