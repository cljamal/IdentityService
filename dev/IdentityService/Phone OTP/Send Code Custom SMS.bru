  }
}

example {
  name: 400 UNSUPPORTED_AUTH_OPERATION
  description: Указанный в примере провайдер не поддерживает эту операцию.

  request: {
    url: {{baseUrl}}/auth/email-password/otp
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "phone": "{{phone}}",
        "sms": {
          "template": "Добро пожаловать в {{service_name}}! Ваш код {{code}}. Не передавайте его никому.",
          "data": {
            "service_name": "Мой сервис"
          }
        }
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 400
      text: Bad Request
    }
    body: {
      type: json
      content: '''
        {
          "code": "UNSUPPORTED_AUTH_OPERATION"
        }
      '''
    }
  }
}

example {
  name: 429 HTTP_RATE_LIMIT
  description: Ограничение частоты HTTP-запросов; отличается от OTP cooldown. APP_DEBUG=false.

  request: {
    url: {{baseUrl}}/auth/phone-otp/otp
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "phone": "{{phone}}",
        "sms": {
          "template": "Добро пожаловать в {{service_name}}! Ваш код {{code}}. Не передавайте его никому.",
          "data": {
            "service_name": "Мой сервис"
          }
        }
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
      retry-after: 60
    }
    status: {
      code: 429
      text: Too Many Requests
    }
    body: {
      type: json
      content: '''
        {
          "message": "Too Many Attempts."
        }
      '''
    }
  }
}

example {
  name: 429 OTP_THROTTLED
  description: Повторная выдача OTP до завершения cooldown; retry_after зависит от оставшегося времени.

  request: {
    url: {{baseUrl}}/auth/phone-otp/otp
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "phone": "{{phone}}",
        "sms": {
          "template": "Добро пожаловать в {{service_name}}! Ваш код {{code}}. Не передавайте его никому.",
          "data": {
            "service_name": "Мой сервис"
          }
        }
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 429
      text: Too Many Requests
    }
    body: {
      type: json
      content: '''
        {
          "code": "OTP_THROTTLED",
          "retry_after": 60
        }
      '''
    }
  }
}

example {
  name: 422 SMS_TEMPLATE_INVALID
  description: Демонстрационный ответ; значения токенов и дат приведены для примера.

  request: {
    url: {{baseUrl}}/auth/phone-otp/otp
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
    }
    body:json: {
      {
        "phone": "{{phone}}",
        "sms": {
          "template": "Ваш код"
        }
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 422
      text: Unprocessable Entity
    }
    body: {
      type: json
      content: '''
        {
          "message": "Шаблон должен содержать {{code}} и только подстановки вида {{name}}.",
          "errors": {
            "sms.template": [
              "Шаблон должен содержать {{code}} и только подстановки вида {{name}}."
            ]
          }
        }
      '''
    }
  }
}
