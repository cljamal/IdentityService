meta {
  name: Confirm New Identifier
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/phone-otp/identifier/change/confirm-new
  body: json
  auth: bearer
}

auth:bearer {
  token: {{phoneToken}}
}

body:json {
  {
    "code": "{{otpCode}}"
  }
}

docs {
  Шаг 3 из 3: номер телефона фактически меняется на новый.
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("phone", bru.getEnvVar("newPhone"));
  }
}
