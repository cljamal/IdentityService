meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/phone-otp/login
  body: json
  auth: none
}

body:json {
  {
    "phone": "{{phone}}",
    "code": "{{otpCode}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data && res.body.data.access_token) {
    bru.setVar("phoneToken", res.body.data.access_token);
    bru.setVar("token", res.body.data.access_token);
    bru.setVar("refreshToken", res.body.data.refresh_token);
  }
}

docs {
  Логин по phone-otp автоматически создаёт пользователя, если такого номера ещё нет
  (firstOrCreateUser). Сохраняет токен в phoneToken/token для остальных запросов.
}

example {
  name: 200
  
  request: {
    url: {{baseUrl}}/auth/phone-otp/login
    method: POST
    mode: json
    body:json: {
      {
        "phone": "{{phone}}",
        "code": "{{otpCode}}"
      }
    }
