meta {
  name: Confirm Account Deletion
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/phone-otp/account/delete/confirm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{phoneToken}}
}

body:json {
  {
    "code": "{{otpCode}}"
  }
}

docs {
  Аккаунт и identities удаляются через soft delete, идентификаторы освобождаются,
  все сессии отзываются и токен текущего запроса инвалидируется.
  Сохранённые runtime-токены этого аккаунта больше не подходят для запросов.
}

example {
  name: 200
  description: Демонстрационный ответ; значения токенов и дат приведены для примера.

  request: {
    url: {{baseUrl}}/auth/phone-otp/account/delete/confirm
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
      Authorization: Bearer {{phoneToken}}
    }
    body:json: {
      {
        "code": "{{otpCode}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "message": "Аккаунт удалён."
          }
        }
      '''
    }
  }
}

example {
  name: 401 CLIENT_AUTHENTICATION_FAILED
  description: Отсутствующие/неверные credentials или отключённый клиент.

  request: {
    url: {{baseUrl}}/auth/phone-otp/account/delete/confirm
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: <invalid-client-secret>
      Content-Type: application/json
      Authorization: Bearer {{phoneToken}}
    }
    body:json: {
      {
        "code": "{{otpCode}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "code": "CLIENT_AUTHENTICATION_FAILED"
        }
      '''
    }
  }
}

example {
  name: 401 UNAUTHENTICATED
  description: Отсутствующий, истёкший, отозванный или недействительный JWT.

  request: {
    url: {{baseUrl}}/auth/phone-otp/account/delete/confirm
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
      Authorization: Bearer <invalid-access-token>
    }
    body:json: {
      {
        "code": "{{otpCode}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "message": "Unauthenticated."
        }
      '''
    }
  }
}

example {
  name: 404 AUTH_PROVIDER_DISABLED
  description: Провайдер отключён в конфигурации.

  request: {
    url: {{baseUrl}}/auth/phone-otp/account/delete/confirm
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
      Authorization: Bearer {{phoneToken}}
    }
    body:json: {
      {
        "code": "{{otpCode}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 404
      text: Not Found
    }
    body: {
      type: json
      content: '''
        {
          "code": "AUTH_PROVIDER_DISABLED"
        }
      '''
    }
  }
}

example {
  name: 400 UNSUPPORTED_AUTH_OPERATION
  description: Указанный в примере провайдер не поддерживает эту операцию.

  request: {
    url: {{baseUrl}}/auth/username-password/account/delete/confirm
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
      Authorization: Bearer {{phoneToken}}
    }
    body:json: {
      {
        "code": "{{otpCode}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 400
      text: Bad Request
    }
    body: {
      type: json
      content: '''
        {
          "code": "UNSUPPORTED_AUTH_OPERATION"
        }
      '''
    }
  }
}

example {
  name: 429 HTTP_RATE_LIMIT
  description: Ограничение частоты HTTP-запросов; отличается от OTP cooldown. APP_DEBUG=false.

  request: {
    url: {{baseUrl}}/auth/phone-otp/account/delete/confirm
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
      Authorization: Bearer {{phoneToken}}
    }
    body:json: {
      {
        "code": "{{otpCode}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
      retry-after: 60
    }
    status: {
      code: 429
      text: Too Many Requests
    }
    body: {
      type: json
      content: '''
        {
          "message": "Too Many Attempts."
        }
      '''
    }
  }
}

example {
  name: 422 INVALID_OTP
  description: Код неверен, истёк или уже использован; для resend нет неподтверждённой регистрации.

  request: {
    url: {{baseUrl}}/auth/phone-otp/account/delete/confirm
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
      Authorization: Bearer {{phoneToken}}
    }
    body:json: {
      {
        "code": "{{otpCode}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 422
      text: Unprocessable Entity
    }
    body: {
      type: json
      content: '''
        {
          "code": "INVALID_OTP"
        }
      '''
    }
  }
}

example {
  name: 422 VALIDATION_ERROR
  description: Обязательное поле отсутствует; пример для APP_LOCALE=en.

  request: {
    url: {{baseUrl}}/auth/phone-otp/account/delete/confirm
    method: POST
    mode: json
    headers: {
      Accept: application/json
      X-Client-Id: {{clientId}}
      X-Client-Secret: {{clientSecret}}
      Content-Type: application/json
      Authorization: Bearer {{phoneToken}}
    }
    body:json: {
      {}
    }
  }

  response: {
    headers: {
      content-type: application/json
    }
    status: {
      code: 422
      text: Unprocessable Entity
    }
    body: {
      type: json
      content: '''
        {
          "message": "The code field is required.",
          "errors": {
            "code": [
              "The code field is required."
            ]
          }
        }
      '''
    }
  }
}
